APP_NAME=SGEP
APP_ENV=local
# Producción: mantener false para no exponer detalles de error al usuario
APP_DEBUG=false
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost/sgep
# macOS MAMP: APP_URL=http://localhost:8888/sgep
# Ruta URL del proyecto (sin /public). El DocumentRoot de Apache debe apuntar a la carpeta public/
APP_BASE_PATH=/sgep

# Exportación F-023 a PDF (LibreOffice headless)
# Ruta absoluta a soffice/soffice.exe; vacío = buscar en tools/libreoffice, PATH o rutas típicas de Windows
F023_LIBREOFFICE_PATH=
# Solo desarrollo sin LO: true permite fallback Dompdf (baja fidelidad). Producción: false
F023_PDF_ALLOW_DOMPDF_FALLBACK=false

DB_HOST=127.0.0.1
DB_PORT=3306
# macOS MAMP: DB_PORT=8889 y DB_PASSWORD=root
DB_DATABASE=sgep
DB_USERNAME=root
DB_PASSWORD=
