# --- PHP ---
/.phpunit.cache
.phpunit.result.cache
/vendor
auth.json
Homestead.json
Homestead.yaml

# Entorno (nunca versionar secretos)
.env
.env.backup
.env.production
.env.*.local

# Claves y almacenamiento sensible
/storage/*.key
/public/storage
/storage/documents/*
/storage/logs/*.log

# Restos de depuración (auditoría de plantillas / XML temporales de trabajo)
/storage/_tpl_audit/
/storage/tmp_*.xml
# Plantillas F-023 (vacías): solo los archivos listados se versionan
/storage/templates/*
!/storage/templates/.gitkeep
!/storage/templates/README.md
!/storage/templates/info.docx
!/storage/templates/m1.docx
!/storage/templates/m2.docx
!/storage/templates/m3_p1.docx
!/storage/templates/m3_p2.docx
!/storage/templates/extra.docx
!/storage/templates/Reporte Maestro.xlsx
/storage/templates/.~lock.*

# --- Node / Vite / frontend ---
/node_modules
/public/build
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Bases de datos locales ---
*.sqlite
*.sqlite-journal
/database/*.sqlite

# --- Herramientas y cachés locales ---
.php-cs-fixer.cache
.phpstan
coverage/
*.cache

# --- IDEs y editores ---
/.fleet
/.idea
/.vscode
*.swp
*.swo
*~

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Reglas de cursor -- #
.cursor/
